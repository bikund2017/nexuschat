{
  "name": "nexuschat",
  "version": "1.0.0",
  "description": "A secure peer-to-peer encrypted chat application built with React, TypeScript, and WebRTC for real-time communication.",
  "homepage": "/",
  "author": "bikund2017",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "chat",
    "p2p",
    "webrtc",
    "encryption",
    "react",
    "typescript",
    "real-time",
    "peer-to-peer"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@react-hook/debounce": "^4.0.0",
    "@react-hook/window-size": "^3.1.1",
    "@tanstack/react-query": "^5.90.19",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@vercel/analytics": "^1.6.1",
    "buffer": "^6.0.3",
    "detectincognitojs": "^1.6.2",
    "fast-memoize": "^2.5.2",
    "file-saver": "^2.0.5",
    "fun-animal-names": "^0.1.1",
    "idb": "^8.0.3",
    "idb-chunk-store": "^1.0.1",
    "localforage": "^1.10.0",
    "modern-normalize": "^2.0.0",
    "mui-markdown": "^0.5.5",
    "random-word-slugs": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-file-reader-input": "^2.0.0",
    "react-git-info": "^2.0.1",
    "react-hotkeys-hook": "^4.6.2",
    "react-markdown": "^9.1.0",
    "react-qrcode-logo": "^2.10.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-youtube": "^10.1.0",
    "readable-web-to-node-stream": "^3.0.2",
    "remark-gfm": "^4.0.1",
    "sdp": "^3.2.1",
    "secure-file-transfer": "^0.0.8",
    "streamsaver": "^2.0.6",
    "trystero": "^0.22.0",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1",
    "uuid": "^8.3.2",
    "vite-plugin-babel-macros": "^1.0.6",
    "webrtc-adapter": "^8.2.4"
  },
  "scripts": {
    "dev": "cross-env VITE_HOMEPAGE=$(npm pkg get homepage) vite --port 3000 --host",
    "build": "cross-env VITE_HOMEPAGE=$(npm pkg get homepage) vite build",
    "preview": "vite preview --port 3000",
    "test": "vitest",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src e2e --max-warnings=0 --fix",
    "prettier": "prettier \"**/*.{ts,tsx}\" --write",
    "check:types": "tsc && echo \"No type errors.\"",
    "generate-rtc-config": "node scripts/generate-rtc-config.cjs",
    "playwright:install": "playwright install --with-deps"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.8.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^18.19.71",
    "@types/react": "^18.2.72",
    "@types/react-dom": "^18.3.1",
    "@types/react-file-reader-input": "^2.0.4",
    "@types/react-syntax-highlighter": "^15.5.5",
    "@types/streamsaver": "^2.0.1",
    "@types/uuid": "^8.3.4",
    "@types/webtorrent": "^0.109.3",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vercel/node": "^5.6.11",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.8",
    "axe-playwright": "^2.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "prettier": "^3.2.5",
    "process": "^0.11.10",
    "url": "^0.11.0",
    "util": "^0.12.5",
    "vite": "^6.4.1",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.0.9"
  },
  "overrides": {
    "ipfs-core": "npm:dry-uninstall",
    "@svgr/plugin-svgo": {
      "nth-check": "2.0.1"
    },
    "react-file-reader-input": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "resolve-url-loader": {
      "postcss": "8.4.31"
    },
    "secure-file-transfer": {
      "readable-web-to-node-stream": "3.0.2"
    },
    "eslint-config-react-app": {
      "@typescript-eslint/eslint-plugin": "^8.35.1",
      "@typescript-eslint/parser": "^8.35.1"
    }
  }
}
